{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "bin/**/*.ts",
    "scripts/**/*.ts",
    "global/**/*.ts",
    "utils/**/*.ts",
    "tests/**/*.ts",
    "units/*/scripts/**/*.ts"
  ]
}
