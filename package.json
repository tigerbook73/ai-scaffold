{
  "name": "ai-skills",
  "version": "3.0.0",
  "description": "Local AI skill library — install all skills globally with pnpm register",
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "register": "pnpm build && node --import tsx scripts/publish.ts",
    "clean": "node --import tsx scripts/clean.ts",
    "lint": "pnpm lint:fix",
    "lint:check": "eslint scripts/**/*.ts src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint scripts/**/*.ts src/**/*.ts tests/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint:check && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --log-level warn --write ."
  },
  "keywords": [
    "ai",
    "claude",
    "skills"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.3+sha512.a19744364a7e248b92657a4ca5973f9354d21caf982579674b1c539f32c7420c47138ad8b1254df07aba9bc782d9b3029e3db34d5dbff974326eb74dac8ff489",
  "dependencies": {
    "cac": "^7.0.0",
    "tsx": "^4.22.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
